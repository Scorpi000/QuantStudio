    {
      "id": "file:QuantStudio/Tools/MathFun.py",
      "type": "file",
      "name": "MathFun.py",
      "filePath": "QuantStudio/Tools/MathFun.py",
      "summary": "提供量化研究所需的数学工具函数集合，包括 Hermite 插值、广义 Hurst 指数计算、分布函数（Logistic、广义 Pareto）、相关系数计算以及基于 cvxpy 的带约束加权回归。",
      "tags": ["utility", "math", "interpolation", "distribution", "regression"],
      "complexity": "complex",
      "languageNotes": "使用 cvxpy 凸优化库实现带约束的加权最小二乘回归，支持 Box 约束、线性等式和不等式约束。"
    },
    {
      "id": "file:QuantStudio/Tools/PerformanceAnalysisFun.py",
      "type": "file",
      "name": "PerformanceAnalysisFun.py",
      "filePath": "QuantStudio/Tools/PerformanceAnalysisFun.py",
      "summary": "提供业绩分析函数，实现单期 Brinson 业绩归因模型和单期 Campisi 债券收益分解模型。",
      "tags": ["utility", "performance-attribution", "brinson", "bond-analysis"],
      "complexity": "simple"
    },
    {
      "id": "file:QuantStudio/Tools/RiskMeasureFun.py",
      "type": "file",
      "name": "RiskMeasureFun.py",
      "filePath": "QuantStudio/Tools/RiskMeasureFun.py",
      "summary": "提供风险测度方法，包括基于极值理论（EVT）的 VaR 和 ES 估计，以及历史模拟、正态分布和 Cornish-Fisher 三种 VaR/CVaR 计算方法。",
      "tags": ["utility", "risk", "var", "extreme-value-theory", "distribution"],
      "complexity": "moderate",
      "languageNotes": "EVT 部分使用最大似然估计拟合广义 Pareto 分布参数，并通过 BFGS 优化器求解。"
    },
    {
      "id": "function:QuantStudio/Tools/MathFun.py:interpolateHermite",
      "type": "function",
      "name": "interpolateHermite",
      "filePath": "QuantStudio/Tools/MathFun.py",
      "lineRange": [10, 21],
      "summary": "实现分段三次 Hermite 插值，根据已知数据点 (x, y) 对目标点 target 进行插值计算。",
      "tags": ["interpolation", "math", "numerical"],
      "complexity": "simple"
    },
